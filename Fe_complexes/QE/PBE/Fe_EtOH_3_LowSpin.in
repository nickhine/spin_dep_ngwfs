&CONTROL
  calculation = 'scf'
  prefix = 'Fe_EtOH_3_LowSpin'
  restart_mode     = 'from_scratch'
  tstress          = .true.
  tprnfor          = .true.
  outdir = './out'
  pseudo_dir = '/storage/nanosim/JTH_PBE/'
/

&SYSTEM
 ibrav = 0
 nat = 28
 nspin = 2
 ntyp = 4
 ecutwfc = 58.80
 starting_magnetization(1) = 1.0  ! Spin polarization
 tot_magnetization = 1.0
 tot_charge = 3
/

&ELECTRONS
diago_david_ndim = 8
electron_maxstep = 1000
conv_thr = 1.0d-9
mixing_beta = 0.3
/

